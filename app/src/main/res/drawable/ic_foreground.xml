<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:height="108dp"
    android:width="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Soft Ambient Ice-Cyan Bloom Aura -->
    <path
        android:fillAlpha="0.14"
        android:pathData="M31,35 h12 l15,19 l-15,19 h-12 l15,-19 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="31"
                android:startY="35"
                android:endX="58"
                android:endY="73"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF00E5FF"/>
                <item android:offset="1.0" android:color="#FF0091EA"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Terminal Chevron '>' with Hyper Electric Cyan & Ice Sheen Gradient -->
    <path
        android:pathData="M34,38
                          h6
                          l12,16
                          l-12,16
                          h-6
                          l12,-16
                          Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="34"
                android:startY="38"
                android:endX="52"
                android:endY="70"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFE0F7FA"/>
                <item android:offset="0.35" android:color="#FF00E5FF"/>
                <item android:offset="1.0" android:color="#FF0091EA"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Terminal Cursor '_' with Crisp Laser Cyan Gradient -->
    <path
        android:pathData="M56,66
                          h18
                          v4
                          h-18
                          Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="56"
                android:startY="66"
                android:endX="74"
                android:endY="70"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF00E5FF"/>
                <item android:offset="1.0" android:color="#FF0091EA"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Glowing Accent Prompt Dot in Brilliant Frost Cyan -->
    <path
        android:pathData="M78,67 a1.5,1.5 0 1,0 3,0 a1.5,1.5 0 1,0 -3,0 Z"
        android:fillColor="#FFB2EBF2"/>

</vector>
