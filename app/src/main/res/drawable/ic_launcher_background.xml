<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:height="108dp"
    android:width="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Base dark background with deep radial depth -->
    <path
        android:pathData="M0,0 h108 v108 h-108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="15"
                android:startY="15"
                android:endX="95"
                android:endY="95"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF0D111E"/>
                <item android:offset="0.5" android:color="#FF070913"/>
                <item android:offset="1.0" android:color="#FF020308"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Subtle Cyberpunk Grid Lines -->
    <path
        android:strokeWidth="0.6"
        android:strokeColor="#1800F5FF"
        android:pathData="M18,0 v108 M36,0 v108 M54,0 v108 M72,0 v108 M90,0 v108 M0,18 h108 M0,36 h108 M0,54 h108 M0,72 h108 M0,90 h108"/>

    <!-- Subtle Radial Vignette / Core Glow -->
    <path
        android:pathData="M24,24 a30,30 0 1,0 60,0 a30,30 0 1,0 -60,0 Z"
        android:fillAlpha="0.08">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="35"
                android:type="radial">
                <item android:offset="0.0" android:color="#FF00F5FF"/>
                <item android:offset="0.6" android:color="#FFFF0080"/>
                <item android:offset="1.0" android:color="#00000000"/>
            </gradient>
        </aapt:attr>
    </path>
</vector>
